{
  "name": "ts-node-starter",
  "description": "TypeScript + Node starter template",
  "license": "MIT",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch src/index.ts",
    "start": "node src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint . --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check . && tsc --noEmit",
    "check:fix": "biome check . --write . && tsc --noEmit",
    "container:build": "docker build -t ts-node-starter .",
    "container:run": "docker run --rm -d -p 3000:3000 ts-node-starter"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
